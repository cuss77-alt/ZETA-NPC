                -- Barrido masivo optimizado para encontrar cualquier NPC o Zombi con vida en todo el espacio de trabajo
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj ~= LocalPlayer.Character then
                        local humanoid = obj:FindFirstChildOfClass("Humanoid")
                        local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")

                        if humanoid and rootPart and humanoid.Health > 0 then
                            -- Evitar seleccionarte a ti mismo o a compañeros si estás en equipo de jugadores
                            local isPlayer = Players:GetPlayerFromCharacter(obj)
                            local validTarget = true

                            if isPlayer then
                                if isPlayer == LocalPlayer or (isPlayer.Team and LocalPlayer.Team and isPlayer.Team == LocalPlayer.Team) then
                                    validTarget = false
                                end
                            end

                            if validTarget then
                                local targetPartObj = obj:FindFirstChild(TargetPart) or rootPart
                                if targetPartObj then
                                    local pos, onScreen = Camera:WorldToViewportPoint(targetPartObj.Position)
                                    if onScreen then
                                        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                                        local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                                        if dist < shortestDist then
                                            shortestDist = dist
                                            closestTarget = targetPartObj
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                -- Fijar la mira y disparar automáticamente al zombi/NPC detectado
                if closestTarget then
                    local targetCF = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF, 0.45) -- Velocidad de rastreo letal y fluida

